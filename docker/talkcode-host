#!/usr/bin/env bash
# talkcode (host side) — operate the gateway container from the machine that runs it
# (docs/docker.md). Installed as /usr/local/bin/talkcode:
#
#   sudo install -m 755 docker/talkcode-host /usr/local/bin/talkcode
#
#   talkcode update [--dry-run] [--force]
#                     pull the image the compose file names; if it changed, recreate the
#                     container, wait until every host is connected again, report the version,
#                     and remove the image it replaced. Refuses while a turn or a scheduled run
#                     is in progress (--force overrides; --dry-run only reports).
#   talkcode restart [--force]   the same check, then a restart without pulling
#   talkcode logs [args]         docker logs -t (default: --tail 200)
#   talkcode status              the container, its image and the gateway's version
#   talkcode <anything else>     runs the talkcode CLI inside the container: `talkcode doctor`,
#                                `talkcode --version`. update / restart / logs / status are not
#                                CLI commands, so nothing is shadowed.
#
# The container's compose directory is $TALKCODE_APP_DIR, by default ~/apps/talkcode, and the
# container is $TALKCODE_CONTAINER, by default talkcode (what docs/docker.md's compose names it).
#
# Why update is a command and not just `docker compose pull && up -d`: recreating the container
# restarts the gateway, and a restarting gateway stops the agents it started on its hosts (see
# docs/remote-hosts.md) — a turn in progress is cut off. When that is acceptable is the operator's
# call, so this says what is running before it does anything, and never runs on a timer.
set -euo pipefail

APP_DIR="${TALKCODE_APP_DIR:-$HOME/apps/talkcode}"
CONTAINER="${TALKCODE_CONTAINER:-talkcode}"
PKG=/usr/local/lib/node_modules/talkcode/package.json

die() { printf '%s\n' "talkcode: $*" >&2; exit 1; }
say() { printf '%s\n' "talkcode: $*" >&2; }
short() { local id="${1#sha256:}"; printf '%s' "${id:0:12}"; }
running() { [ "$(docker inspect -f '{{.State.Status}}' "${CONTAINER}" 2>/dev/null)" = running ]; }
version() { docker exec "${CONTAINER}" node -p "require('${PKG}').version" 2>/dev/null || echo unknown; }

# What the gateway is doing right now, read from its own log since the container last started:
# a turn is open from "starting turn" until "turn complete|stopped|failed", a scheduled run from
# "running" until "finished". The log is the daemon's own account, so no new interface is needed;
# a run that started before the log rotated away is the one thing this cannot see.
in_progress() {
    local since
    since="$(docker inspect -f '{{.State.StartedAt}}' "${CONTAINER}")"
    docker logs --since "${since}" "${CONTAINER}" 2>&1 | awk '
        /^\[turn\] [^ ]+ starting turn/            { open["turn " $2] = 1 }
        /^\[turn\] [^ ]+ turn (complete|stopped|failed)/ { delete open["turn " $2] }
        /^\[schedule\] #[^ ]+ .* running/          { open["scheduled task " $2] = 1 }
        /^\[schedule\] #[^ ]+ finished:/           { delete open["scheduled task " $2] }
        END { for (k in open) print k }'
}

# Stop here if something would be cut off, unless forced. --dry-run reports and goes on: its
# whole purpose is to show what would happen.
guard() {
    local force="$1" dry="$2" busy
    running || return 0
    busy="$(in_progress)"
    [ -n "${busy}" ] || return 0
    say "in progress now — a restart cuts these off (the conversations are kept):"
    printf '%s\n' "${busy}" | sed 's/^/    /' >&2
    if [ "${dry}" -eq 0 ] && [ "${force}" -eq 0 ]; then
        die "add --force once they can be interrupted"
    fi
}

# Wait for the restarted gateway to be up and to have reached every host it had reached before,
# and print what it said about it. The hosts are taken from the previous run's log rather than
# from config.yaml, which this would otherwise have to parse.
#
# The log is read into a variable and matched there, never piped into `grep -q`: under pipefail,
# grep exiting at its first match kills `docker logs` with SIGPIPE, and the pipeline then reports
# failure for a line it found — more often the longer the log.
settle() {
    local hosts="$1" since log missing up
    for _ in $(seq 1 30); do running && break; sleep 0.5; done
    running || die "the container is not running after 15s: docker logs ${CONTAINER}"
    since="$(docker inspect -f '{{.State.StartedAt}}' "${CONTAINER}")"
    for _ in $(seq 1 60); do
        log="$(docker logs --since "${since}" "${CONTAINER}" 2>&1)"
        missing="" up=0
        for h in ${hosts}; do
            grep -q "^\[remote\] ${h}: connected" <<<"${log}" || missing="${missing} ${h}"
        done
        if grep -q 'talkcode daemon is running' <<<"${log}"; then up=1; fi
        if [ "${up}" -eq 1 ] && [ -z "${missing}" ]; then break; fi
        sleep 1
    done
    grep -E '^(🚀|\[remote\] .*: (connected|connection attempt failed)|\[slash\] .*registered|\[daemon\] platform instance)' \
        <<<"${log}" | sed 's/^/    /' >&2 || true
    [ "${up}" -eq 1 ] || die "the gateway has not reported running after 60s: talkcode logs"
    [ -z "${missing}" ] || die "not connected after 60s:${missing} — talkcode logs"
}

previous_hosts() {
    running || return 0
    docker logs --since "$(docker inspect -f '{{.State.StartedAt}}' "${CONTAINER}")" "${CONTAINER}" 2>&1 \
        | sed -n 's/^\[remote\] \([^:]*\): connected.*/\1/p' | sort -u | tr '\n' ' '
}

# The image a new pull left without a tag, and only this repository's: filtered by the
# org.opencontainers.image.source label the build puts on it, so other services' dangling images
# are not this command's to remove. prune never removes an image a container still uses.
prune_old() {
    local src out freed
    src="$(docker image inspect "$1" -f '{{index .Config.Labels "org.opencontainers.image.source"}}' 2>/dev/null || true)"
    [ -n "${src}" ] || { say "$1 has no org.opencontainers.image.source label; not pruning"; return 0; }
    out="$(docker image prune -f --filter "label=org.opencontainers.image.source=${src}" 2>&1)" \
        || { say "pruning old images failed (the container is fine): ${out}"; return 0; }
    freed="$(printf '%s\n' "${out}" | sed -n 's/^Total reclaimed space: //p')"
    case "${freed}" in ''|0B) ;; *) say "removed the replaced image, ${freed} reclaimed" ;; esac
}

do_update() {
    local force=0 dry=0 ref before after hosts
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --force) force=1 ;; --dry-run) dry=1 ;;
            *) die "update: unknown argument $1 (--force, --dry-run)" ;;
        esac
        shift
    done
    [ -f "${APP_DIR}/docker-compose.yml" ] || die "no ${APP_DIR}/docker-compose.yml (set TALKCODE_APP_DIR)"
    # Read from the compose file, not hard-coded: pinning a version there is followed here.
    ref="$(sed -n 's/^[[:space:]]*image:[[:space:]]*//p' "${APP_DIR}/docker-compose.yml" | head -1)"
    [ -n "${ref}" ] || die "no image: in ${APP_DIR}/docker-compose.yml"
    # Image IDs, not tags: `latest` moves.
    before="$(docker inspect -f '{{.Image}}' "${CONTAINER}" 2>/dev/null || true)"
    say "pulling ${ref} …"
    (cd "${APP_DIR}" && docker compose pull -q) >&2 || die "pull failed"
    after="$(docker image inspect "${ref}" -f '{{.Id}}')" || die "pulled, but cannot inspect ${ref}"
    if [ "${before}" = "${after}" ]; then
        say "already up to date ($(short "${after}"), talkcode $(version)); the container is left alone"
        [ "${dry}" -eq 1 ] || prune_old "${ref}"
        return 0
    fi
    say "image $(short "${before:-none}") → $(short "${after}")"
    guard "${force}" "${dry}"
    if [ "${dry}" -eq 1 ]; then
        say "--dry-run: stopping here (the new image is pulled; the next update switches to it)"
        return 0
    fi
    hosts="$(previous_hosts)"
    (cd "${APP_DIR}" && docker compose up -d) >&2 || die "up -d failed: cd ${APP_DIR} && docker compose logs"
    settle "${hosts}"
    prune_old "${ref}"
    say "done: talkcode $(version)"
}

do_restart() {
    local force=0 hosts
    case "${1:-}" in --force) force=1 ;; '') ;; *) die "restart: unknown argument $1 (--force)" ;; esac
    guard "${force}" 0
    hosts="$(previous_hosts)"
    (cd "${APP_DIR}" && docker compose restart) >&2 || die "restart failed"
    settle "${hosts}"
    say "restarted: talkcode $(version)"
}

command -v docker >/dev/null || die "docker not found"
case "${1:-}" in
    update)  shift; do_update "$@" ;;
    restart) shift; do_restart "$@" ;;
    logs)    shift; if [ "$#" -eq 0 ]; then set -- --tail 200; fi; exec docker logs -t "$@" "${CONTAINER}" ;;
    status)
        docker ps -a --filter "name=^/${CONTAINER}$" --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}\t{{.Ports}}'
        if running; then
            printf 'talkcode %s, image %s\n' "$(version)" "$(short "$(docker inspect -f '{{.Image}}' "${CONTAINER}")")"
            busy="$(in_progress)"
            if [ -n "${busy}" ]; then printf 'in progress:\n'; printf '%s\n' "${busy}" | sed 's/^/    /'
            else printf 'in progress: nothing\n'; fi
        fi ;;
    -h|--help|'') awk 'NR > 1 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "$0" ;;
    *)
        running || die "the container is not running: talkcode status"
        flags=(-i); if [ -t 0 ] && [ -t 1 ]; then flags=(-i -t); fi
        exec docker exec "${flags[@]}" "${CONTAINER}" talkcode "$@" ;;
esac
